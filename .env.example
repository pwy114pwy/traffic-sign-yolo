# ============================================
# 交通标志识别系统环境配置示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置

# --------------------------------------------
# 项目路径配置
# --------------------------------------------
# 项目根目录（默认自动检测，通常无需修改）
# PROJECT_ROOT=d:\traffic-sign-yolo

# --------------------------------------------
# 模型配置
# --------------------------------------------
# 模型权重文件路径
# 选项1：使用训练好的交通标志检测模型（推荐，需要先训练）
# WEIGHTS_PATH=yolov5/runs/train/exp3/weights/best.pt

# 选项2：使用预训练的 YOLOv5s 模型（临时方案，可立即运行）
# 注意：此模型是在 COCO 数据集上训练的，未针对交通标志优化
WEIGHTS_PATH="yolov5s.pt"


# --------------------------------------------
# 文件存储配置
# --------------------------------------------
# 上传文件保存目录
UPLOAD_FOLDER=web/static/uploads

# 检测结果保存目录
RESULT_FOLDER=web/static/results

# --------------------------------------------
# 检测参数配置
# --------------------------------------------
# 异常检测置信度阈值（低于此值的检测视为未知标志）
ANOMALY_CONF_THRES=0.5

# 图片缩放阈值（像素）
# 如果图片最小边小于此值，会自动放大以确保标签清晰
SCALE_THRESHOLD=200

# --------------------------------------------
# Flask Web 服务器配置
# --------------------------------------------
# 服务器监听地址（0.0.0.0 表示允许外部访问）
FLASK_HOST=0.0.0.0

# 服务器端口
FLASK_PORT=5000

# 调试模式（生产环境请设置为 False）
FLASK_DEBUG=False

# --------------------------------------------
# 日志配置
# --------------------------------------------
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log
